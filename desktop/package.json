{
  "name": "belesify",
  "productName": "Wavelet",
  "version": "1.2.0",
  "description": "Wavelet müzik çalar",
  "author": "Wavelet",
  "main": "main.js",
  "build": {
    "appId": "app.belesify",
    "productName": "Wavelet",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wavelet",
      "artifactName": "Wavelet-Kurulum-${version}.exe"
    },
    "portable": {
      "artifactName": "Wavelet-Tasinabilir-${version}.exe"
    }
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "prestart": "node copy-web.js",
    "prebuild:win": "node copy-web.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
